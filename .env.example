# 複製成 .env 後填入自己的值 —— 程式啟動時會自動載入。
# 也可以直接 export 到 shell（已存在的環境變數優先於此檔）。
# .env 已在 .gitignore 裡，不會進版控。建議 chmod 600 .env。
# 留空的項目會被略過，不會被設成空字串。

# ── Google OAuth 用戶端（必要）─────────────────
# 取得：https://console.cloud.google.com/apis/credentials
#       → 建立憑證 → OAuth 用戶端 ID → 桌面應用程式
# 設了這兩個就不需要 client_secret.json
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Google Sheet（選用）───────────────────────
# 設了就不需要 sheet.json；ID 是試算表網址 /d/ 後面那一段
MUSIC_TOOL_SHEET_ID=

# 放寬 Sheets 權限範圍（預設 drive.file，只能碰本程式建立的檔案）
# 只有需要接管手動建立的試算表時才改成 spreadsheets
# MUSIC_TOOL_SHEET_SCOPE=spreadsheets

# 註：自架網頁（index.html）不需要任何環境變數 —— 它是通用版，
# 試算表網址由使用者在頁面上貼入。詳見 README「手機網頁」。

# ── AI 標籤金鑰（推薦 Google Gemini，100% 免費、速度最快）───────
# 前往 https://aistudio.google.com/ 點擊「Get API key」即可免費取得（免綁信用卡）
GEMINI_API_KEY=
# 可選模型：gemini-2.5-flash（預設推薦）、gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ── 備用 AI 標籤金鑰（Anthropic Claude）────────────────
# 若未設定 GEMINI_API_KEY，且有 ANTHROPIC_API_KEY 則自動切換 Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
